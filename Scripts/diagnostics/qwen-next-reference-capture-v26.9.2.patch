diff --git a/src/qwen4_numerical_capture.zig b/src/qwen4_numerical_capture.zig
new file mode 100644
index 0000000..52e976e
--- /dev/null
+++ b/src/qwen4_numerical_capture.zig
@@ -0,0 +1,34 @@
+// Local diagnosis only; never a benchmark or a release feature. Capture the
+// first prefill's real layer-0 inputs/outputs, without replacing any equation.
+// Requires an explicit fresh output filename and fires once per process.
+const std = @import("std");
+const mlx = @import("mlx.zig");
+var claimed = false; // The inference thread is the sole caller.
+
+pub const Capture = struct {
+    path: [*:0]const u8,
+    arrays: mlx.mlx_map_string_to_array,
+
+    pub fn begin(offset: usize, batch: c_int, length: c_int) ?Capture {
+        if (claimed or offset != 0 or batch != 1 or length <= 1) return null;
+        const path = std.c.getenv("QWEN4_NUMERICAL_CAPTURE") orelse return null;
+        const width_text = std.c.getenv("QWEN4_NUMERICAL_CAPTURE_WIDTH") orelse return null;
+        const width = std.fmt.parseInt(c_int, std.mem.span(width_text), 10) catch return null;
+        if (length != width) return null; // Never capture the loader's warmup.
+        claimed = true;
+        return .{ .path = path, .arrays = mlx.mlx_map_string_to_array_new() };
+    }
+    pub fn add(self: *Capture, name: [*:0]const u8, value: mlx.mlx_array) !void {
+        try mlx.check(mlx.mlx_map_string_to_array_insert(self.arrays, name, value));
+    }
+    pub fn write(self: *Capture) !void {
+        const metadata = mlx.mlx_map_string_to_string_new();
+        defer _ = mlx.mlx_map_string_to_string_free(metadata);
+        try mlx.check(mlx.mlx_map_string_to_string_insert(metadata, "scope", "first-prefill-layer-0-diagnostic-not-performance"));
+        try mlx.check(mlx.mlx_save_safetensors(self.path, self.arrays, metadata));
+        std.debug.print("[numerical-capture] saved {s}\n", .{self.path});
+    }
+    pub fn deinit(self: *Capture) void {
+        _ = mlx.mlx_map_string_to_array_free(self.arrays);
+    }
+};
